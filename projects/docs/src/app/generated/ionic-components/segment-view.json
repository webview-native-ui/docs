[{"kind":"html","html":"<p>Segment view is a wrapper element that links a group of <a class=\"\" href=\"/components/segment-content\">segment contents</a> to a <a class=\"\" href=\"/components/segment\">segment</a> when using swipeable segments.\nRefer to our <a class=\"\" href=\"/components/segment#swipeable-segments\">swipeable segments</a> documentation for more information on how to use segment views.</p>"},{"kind":"heading","level":2,"id":"properties","text":"Properties"},{"kind":"heading","level":3,"id":"prop-disabled","text":"disabled"},{"kind":"html","html":"<div class=\"tableWrapper_flOe\"><table><tbody><tr><td><strong>Description</strong></td><td>If <code>true</code>, the segment view cannot be interacted with.</td></tr><tr><td><strong>Attribute</strong></td><td><code>disabled</code></td></tr><tr><td><strong>Type</strong></td><td><code>boolean</code></td></tr><tr><td><strong>Default</strong></td><td><code>false</code></td></tr></tbody></table></div>"},{"kind":"heading","level":3,"id":"prop-swipe-gesture","text":"swipeGesture"},{"kind":"html","html":"<div class=\"tableWrapper_flOe\"><table><tbody><tr><td><strong>Description</strong></td><td>If <code>true</code>, users will be able to swipe the segment view to navigate between segment contents.</td></tr><tr><td><strong>Attribute</strong></td><td><code>swipe-gesture</code></td></tr><tr><td><strong>Type</strong></td><td><code>boolean</code></td></tr><tr><td><strong>Default</strong></td><td><code>true</code></td></tr></tbody></table></div>"},{"kind":"heading","level":2,"id":"events","text":"Events"},{"kind":"html","html":"<div class=\"tableWrapper_flOe\"><table><thead><tr><th>Name</th><th>Description</th><th>Bubbles</th></tr></thead><tbody><tr><td><code>ionSegmentViewScroll</code></td><td>Emitted when the segment view is scrolled.</td><td><code>true</code></td></tr></tbody></table></div>"},{"kind":"heading","level":2,"id":"methods","text":"Methods"},{"kind":"html","html":"<p>No public methods available for this component.</p>"},{"kind":"heading","level":2,"id":"css-shadow-parts","text":"CSS Shadow Parts"},{"kind":"html","html":"<p>No CSS shadow parts available for this component.</p>"},{"kind":"heading","level":2,"id":"css-custom-properties","text":"CSS Custom Properties"},{"kind":"html","html":"<p>No CSS custom properties available for this component.</p>"},{"kind":"heading","level":2,"id":"slots","text":"Slots"},{"kind":"html","html":"<p>No slots available for this component.</p>"}]