{
  "name": "webview-native-ui-docs",
  "version": "0.0.1",
  "private": true,
  "description": "WebView Native UI documentation",
  "license": "MIT",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "ng": "ng",
    "docs:generate": "npm run docs:generate:content",
    "docs:generate:content": "tsx scripts/generate-docs.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "sponsors:generate": "tsx scripts/generate-sponsors.ts",
    "prestart": "npm run docs:generate && tsx scripts/theme-preview.ts --dev",
    "start": "ng serve docs",
    "prestart:ja": "npm run docs:generate && tsx scripts/theme-preview.ts --dev",
    "start:ja": "ng serve --configuration ja",
    "prestart:fr": "npm run docs:generate && tsx scripts/theme-preview.ts --dev",
    "start:fr": "ng serve docs --configuration fr",
    "prestart:de": "npm run docs:generate && tsx scripts/theme-preview.ts --dev",
    "start:de": "ng serve docs --configuration de",
    "static:prepare": "tsx scripts/static-prepare.ts && tsx scripts/theme-preview.ts",
    "build": "npm run build:docs && npm run docs-agent-router:check && npm run legacy-domain:check",
    "prebuild:docs": "npm run docs:generate",
    "build:docs": "ng build docs && npm run static:prepare && pagefind --site dist/docs/browser --output-subdir pagefind && tsx --test scripts/build-output.test.ts",
    "build:docs-agent-router": "npm run docs:generate:content && npm run docs-agent-router:check",
    "docs-agent-router:check": "tsc -p tsconfig.docs-agent-router.json && WRANGLER_LOG_PATH=/tmp/rdlabo-docs-agent-router-wrangler.log wrangler deploy --dry-run --config wrangler.docs-agent-router.jsonc",
    "watch": "ng build docs --watch --configuration development",
    "pretest": "npm run docs:generate",
    "test": "tsx --test scripts/translation-code.test.ts scripts/docs-locales.test.ts scripts/docs-translation-review.test.ts scripts/iphone-duo-examples.test.ts scripts/docgen-api.test.ts scripts/docgen-inline-code.test.ts scripts/docgen-readme.test.ts scripts/html-policy.test.ts scripts/markdown-headings.test.ts scripts/localized-heading-anchors.test.ts scripts/package-markdown.test.ts scripts/package-repository.test.ts scripts/github-sponsors.test.ts scripts/bilingual-update-blocker.test.ts scripts/site-contract.test.ts scripts/seo-dates.test.ts scripts/seo-audit.test.ts scripts/migration.test.ts scripts/legacy-domain.test.ts shared/json-ld.test.ts && vitest run scripts/docs-agent-router.test.ts && ng test docs --watch=false",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "deploy": "npm run build && npm run deploy:docs && npm run deploy:legacy-domain",
    "deploy:docs": "wrangler deploy",
    "deploy:docs-agent-router": "npm run docs:generate:content && WRANGLER_LOG_PATH=/tmp/rdlabo-docs-agent-router-wrangler.log wrangler deploy --config wrangler.docs-agent-router.jsonc",
    "deploy:dry-run": "npm run build && npm run deploy:docs:dry-run && npm run legacy-domain:check",
    "deploy:docs:dry-run": "wrangler deploy --dry-run",
    "deploy:docs-agent-router:dry-run": "npm run build:docs-agent-router",
    "serve:ssr:docs": "node dist/docs/server/server.mjs",
    "lint": "ng lint docs",
    "docs:stage-translations": "tsx scripts/stage-docs-translations.ts",
    "docs:validate-translations": "tsx scripts/validate-docs-translations.ts",
    "migration:verify-source": "tsx scripts/verify-migration.ts",
    "legacy-domain:check": "wrangler deploy --dry-run --config wrangler.legacy-domain.jsonc",
    "deploy:legacy-domain": "wrangler deploy --config wrangler.legacy-domain.jsonc"
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@x402/core": "^2.26.0",
    "@x402/evm": "^2.26.0",
    "@x402/hono": "^2.26.0",
    "express": "^5.1.0",
    "front-matter": "^4.0.2",
    "hono": "^4.13.8",
    "hono-jev-router": "^0.2.0",
    "jose": "^6.2.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zenn-content-css": "^0.5.2",
    "zenn-markdown-html": "^0.5.2"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/docgen": "0.3.1",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@erkamyaman/capacitor-foldable": "8.5.1",
    "@eslint/js": "^10.0.1",
    "@ionic/core": "8.8.19",
    "@rdlabo/capacitor-native-ui": "2.1.4",
    "@rdlabo/eslint-plugin-rules": "22.1.1",
    "@rdlabo/ionic-theme-ios26": "9.4.3",
    "@rdlabo/ionic-theme-ios27": "2.1.3",
    "@rdlabo/ionic-theme-md3": "9.2.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.17.19",
    "@types/turndown": "^5.0.6",
    "@webview-native-ui/cordova-plugin": "0.1.1",
    "@webview-native-ui/engine": "1.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "22.1.0",
    "cf-workers-native": "0.1.8",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "pagefind": "1.5.2",
    "postcss": "^8.5.3",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.6",
    "turndown": "^7.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.0.8",
    "wrangler": "4.123.0"
  }
}
